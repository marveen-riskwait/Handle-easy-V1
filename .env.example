# ── Backend ─────────────────────────────────────────────
# Postgres connection string (production). In docker-compose it's set for you.
# LEAVE EMPTY in a plain dev/Codespace to fall back to a local SQLite file.
# Example prod value: postgresql://rdvcycles:rdvcycles@localhost:5432/rdvcycles
DATABASE_URL=

# Secret used to sign JWTs. Change in production (use a long random string).
FLASK_APP_KEY=super-secret-change-me

# Entry point + debug for the `flask` CLI.
FLASK_APP=src/app.py
FLASK_DEBUG=1

# Public base URL of the frontend (CORS + email links).
FRONTEND_URL=http://localhost:3000

# ── Frontend (Vite) ─────────────────────────────────────
# Base URL of the Flask API. LEAVE EMPTY: the Vite dev server proxies /api to
# the backend (vite.config.js), so the SPA talks same-origin. Setting a value
# here makes the browser call a cross-site host and breaks the httpOnly cookie
# + CSRF flow under Codespaces/tunnels (SameSite=Lax). Only set it if you serve
# the API on a different origin *and* configure cross-site cookies accordingly.
VITE_BACKEND_URL=
