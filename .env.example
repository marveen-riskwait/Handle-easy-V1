# ── Backend ─────────────────────────────────────────────
# Postgres connection string. In docker-compose this is set for you.
# Leave empty to fall back to a local SQLite file (dev only).
DATABASE_URL=postgresql://handleeasy:handleeasy@localhost:5432/handleeasy

# Secret used to sign JWTs. Change in production.
FLASK_APP_KEY=super-secret-change-me

# Entry point + debug for the `flask` CLI.
FLASK_APP=src/app.py
FLASK_DEBUG=1

# Public base URL of the frontend — used to build the QR code target
# (e.g. https://app.example.com/table/<token>).
FRONTEND_URL=http://localhost:3000

# Odoo integration. ODOO_MOCK=1 returns seeded fixtures and never talks
# to a real Odoo — keep it on until you wire real credentials per company.
ODOO_MOCK=1

# ── Frontend (Vite) ─────────────────────────────────────
# Base URL of the Flask API. Empty = same origin (production build).
VITE_BACKEND_URL=http://localhost:3001
